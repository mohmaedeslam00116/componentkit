{
  "name": "@shadowskit/cli",
  "version": "0.1.0",
  "description": "CLI tool for scaffolding @shadowskit/ui components into your project",
  "bin": {
    "shadowskit": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "execa": "^9.5.2",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "component-library",
    "ui",
    "tailwind",
    "radix",
    "shadowskit"
  ],
  "license": "MIT"
}
